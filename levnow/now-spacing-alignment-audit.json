    "hero": {
      "type": "hero",
      "variant": "editorial",
      "props": {
        "category": "RenderSpec visual failure analysis",
        "title": "The renderer has no root layout contract",
        "subtitle": "Agents are composing valid graphs into a container that supplies neither flow spacing nor alignment mediation.",
        "meta": "40 pages × 3 widths · 384 measured root components · 2026-07-22"
      }
    },
    "verdict": {
      "type": "decision",
      "props": {
        "status": "blocked",
        "title": "Retract the prior visually-good verdict",
        "content": "Functional acceptance remains green, but visual acceptance was false-green. The corpus contains 184 bad component adjacencies: 128 touching, 31 overlapping, 8 too tight, and 48 unmediated rail changes.",
        "next": "Define one parent-owned flow and rail contract, then make the acceptance harness measure every seam on full-page captures."
      }
    },
    "failure-map": {
      "type": "diagram",
      "props": {
        "engine": "mermaid",
        "content": "flowchart LR\n  A[Agent decomposes request] --> B[Flat root list]\n  B --> C[Schema accepts every element type]\n  C --> D[Renderer joins HTML fragments]\n  D --> E[Plain block container\\nrow-gap: normal]\n  E --> F[Component-local widths and margins]\n  F --> G[Touching blocks\\nand rail jumps]\n  H[First-viewport screenshots] --> I[Lower seams never inspected]\n  I --> J[False green verdict]",
        "caption": "The failure is architectural: composition is first-class, but component flow is not."
      }
    },
    "metrics": {
      "type": "section",
      "variant": "kpi-row",
