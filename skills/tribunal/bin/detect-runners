#!/usr/bin/env python3
"""Detect standalone CLI agents and cache their current model rosters."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from typing import Any, Callable


CACHE_TTL_SECONDS = 24 * 60 * 60
CACHE_PATH = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "tribunal" / "runners.json"
COMMAND_TIMEOUT_SECONDS = 12


def parse_codex(text: str) -> list[str]:
    payload = json.loads(text)
    return [
        str(model["slug"])
        for model in payload.get("models", [])
        if model.get("slug") and model.get("visibility", "list") == "list"
    ]


def parse_cursor(text: str) -> list[str]:
    models = []
    for line in text.splitlines():
        model_id, separator, _ = line.partition(" - ")
        if separator and model_id.strip() != "auto":
            models.append(model_id.strip())
    return models


def parse_lines(text: str) -> list[str]:
    return [line.strip() for line in text.splitlines() if line.strip()]


def parse_opencode(text: str) -> list[str]:
    return [line.strip() for line in text.splitlines() if "/" in line and " " not in line.strip()]


def parse_pi(text: str) -> list[str]:
    models = []
    for line in text.splitlines()[1:]:
        columns = line.split()
        if len(columns) >= 2:
            models.append(f"{columns[0]}/{columns[1]}")
    return models


RUNNERS: list[dict[str, Any]] = [
    {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "declared_models": ["haiku", "sonnet", "opus", "fable"],
        "model_source": "declared-aliases",
        "exhaustive": False,
    },
    {
        "id": "codex",
        "name": "Codex CLI",
        "command": "codex",
        "model_command": ["codex", "debug", "models"],
        "model_parser": parse_codex,
        "model_source": "provider-command",
        "exhaustive": True,
    },
    {
        "id": "gemini",
        "name": "Gemini CLI",
        "command": "gemini",
        "model_source": "explicit-required",
        "exhaustive": False,
    },
    {
        "id": "agy",
        "name": "Antigravity CLI",
        "command": "agy",
        "model_command": ["agy", "models"],
        "model_parser": parse_lines,
        "model_source": "provider-command",
        "exhaustive": True,
    },
    {
        "id": "cursor-agent",
        "name": "Cursor Agent",
        "command": "cursor-agent",
        "model_command": ["cursor-agent", "models"],
        "model_parser": parse_cursor,
        "model_source": "provider-command",
        "exhaustive": True,
    },
    {
        "id": "opencode",
        "name": "OpenCode",
        "command": "opencode",
        "model_command": ["opencode", "models"],
        "model_parser": parse_opencode,
        "model_source": "provider-command",
        "exhaustive": True,
    },
    {
        "id": "pi",
        "name": "Pi Agent",
        "command": "pi",
        "model_command": ["pi", "--list-models"],
        "model_parser": parse_pi,
        "model_source": "provider-command",
        "exhaustive": True,
    },
    {
        "id": "aider",
        "name": "Aider",
        "command": "aider",
        "model_source": "explicit-required",
        "exhaustive": False,
    },
]

RUNNER_ALIASES = {"cursor": "cursor-agent", "agent": "cursor-agent", "antigravity": "agy"}


def run_command(argv: list[str], timeout: int = COMMAND_TIMEOUT_SECONDS) -> tuple[int, str, str]:
    process = subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
        return process.returncode, stdout, stderr
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            stdout, stderr = process.communicate(timeout=2)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            stdout, stderr = process.communicate()
        raise TimeoutError(f"command timed out after {timeout}s: {' '.join(argv)}")


def unique(values: list[str]) -> list[str]:
    return list(dict.fromkeys(value for value in values if value))


def detect_runner(spec: dict[str, Any]) -> dict[str, Any]:
    path = shutil.which(spec["command"])
    result: dict[str, Any] = {
        "id": spec["id"],
        "name": spec["name"],
        "command": spec["command"],
        "installed": path is not None,
        "path": path or "",
        "version": "",
        "models": [],
        "model_count": 0,
        "model_discovery": {
            "source": spec["model_source"],
            "exhaustive": spec["exhaustive"],
            "status": "binary-missing" if path is None else "pending",
        },
    }
    if path is None:
        return result

    try:
        _, stdout, stderr = run_command([spec["command"], "--version"], timeout=5)
        result["version"] = (stdout or stderr).splitlines()[0].strip()
    except (IndexError, TimeoutError, OSError):
        result["version"] = "unknown"

    declared = spec.get("declared_models")
    if declared:
        result["models"] = declared
        result["model_count"] = len(declared)
        result["model_discovery"]["status"] = "declared-partial"
        return result

    command = spec.get("model_command")
    parser: Callable[[str], list[str]] | None = spec.get("model_parser")
    if command is None or parser is None:
        result["model_discovery"]["status"] = "explicit-required"
        return result

    result["model_discovery"]["command"] = command
    try:
        returncode, stdout, stderr = run_command(command)
        if returncode != 0:
            result["model_discovery"]["status"] = "command-failed"
            result["model_discovery"]["error"] = (stderr or stdout).strip()[:500]
            return result
        models = unique(parser(stdout))
        result["models"] = models
        result["model_count"] = len(models)
        result["model_discovery"]["status"] = "available" if models else "no-models"
    except TimeoutError as error:
        result["model_discovery"]["status"] = "timeout"
        result["model_discovery"]["error"] = str(error)
    except (json.JSONDecodeError, OSError, ValueError) as error:
        result["model_discovery"]["status"] = "parse-failed"
        result["model_discovery"]["error"] = str(error)
    return result


def fresh_cache() -> dict[str, Any] | None:
    try:
        if time.time() - CACHE_PATH.stat().st_mtime >= CACHE_TTL_SECONDS:
            return None
        cached = json.loads(CACHE_PATH.read_text())
        if cached.get("schema_version") != "tribunal-runner-catalog.v2":
            return None
        return cached
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def refresh_cache() -> dict[str, Any]:
    with ThreadPoolExecutor(max_workers=len(RUNNERS)) as pool:
        runners = list(pool.map(detect_runner, RUNNERS))
    payload = {
        "schema_version": "tribunal-runner-catalog.v2",
        "detected_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "hostname": socket.gethostname().split(".")[0],
        "cache": {"path": str(CACHE_PATH), "ttl_seconds": CACHE_TTL_SECONDS, "status": "refresh"},
        "runners": runners,
    }
    CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = CACHE_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2) + "\n")
    temporary.replace(CACHE_PATH)
    return payload


def load_catalog(refresh: bool) -> dict[str, Any]:
    if not refresh:
        cached = fresh_cache()
        if cached is not None:
            cached["cache"]["status"] = "fresh-cache"
            cached["cache"]["age_seconds"] = int(time.time() - CACHE_PATH.stat().st_mtime)
            return cached
    return refresh_cache()


def select_runner(catalog: dict[str, Any], requested: str) -> dict[str, Any] | None:
    runner_id = RUNNER_ALIASES.get(requested, requested)
    return next((runner for runner in catalog["runners"] if runner["id"] == runner_id), None)


def self_test() -> None:
    assert parse_codex('{"models":[{"slug":"small","visibility":"list"},{"slug":"hidden","visibility":"hide"}]}') == ["small"]
    assert parse_cursor("auto - Auto\nsmall - Small\nlarge - Large\n") == ["small", "large"]
    assert parse_opencode("openai/small\nanthropic/large\n") == ["openai/small", "anthropic/large"]
    assert parse_pi("provider model context\nopenai small 1M\ngoogle flash 1M\n") == ["openai/small", "google/flash"]
    assert unique(["a", "a", "b", ""]) == ["a", "b"]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--refresh", action="store_true", help="bypass the 24-hour cache")
    parser.add_argument("--json", action="store_true", help="emit JSON")
    parser.add_argument("--models", metavar="RUNNER", help="show one runner's discovered models")
    parser.add_argument("--self-test", action="store_true", help="run parser checks and exit")
    args = parser.parse_args()

    if args.self_test:
        self_test()
        print("detect-runners self-test: ok")
        return 0

    catalog = load_catalog(args.refresh)
    if args.models:
        runner = select_runner(catalog, args.models)
        if runner is None:
            parser.error(f"unknown runner: {args.models}")
        if args.json:
            print(json.dumps(runner, indent=2))
        else:
            for model in runner["models"]:
                print(model)
            if not runner["models"]:
                status = runner["model_discovery"]["status"]
                print(f"{runner['id']}: no discovered models ({status})", file=sys.stderr)
        return 0 if runner["models"] else 2

    if args.json:
        print(json.dumps(catalog, indent=2))
        return 0

    for runner in catalog["runners"]:
        marker = "*" if runner["installed"] else "-"
        discovery = runner["model_discovery"]
        completeness = "all" if discovery["exhaustive"] else "partial"
        print(
            f"{marker} {runner['id']:<14} {runner['model_count']:>4} models  "
            f"{discovery['status']:<16} {completeness}"
        )
    print(f"cache: {catalog['cache']['status']}  {catalog['cache']['path']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
