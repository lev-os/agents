      "github_url": "https://github.com/inference-sh/skills/tree/main/tools/video/remotion-render",
      "slug": "remotion-render",
      "source": "community",
      "source_label": "inference.sh",
      "stars_reported": 569,
      "template_expressions": [],
      "title": "Remotion Render"
    },
