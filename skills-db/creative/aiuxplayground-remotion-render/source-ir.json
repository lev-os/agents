      {
        "line": 131,
        "text": "## Python SDK"
      },
      {
        "line": 132,
        "text": ""
      },
      {
        "line": 133,
        "text": "```python"
      },
      {
        "line": 134,
        "text": "from inferencesh import inference"
      },
      {
        "line": 135,
        "text": ""
      },
      {
        "line": 136,
        "text": "client = inference()"
      },
      {
        "line": 137,
        "text": ""
      },
      {
        "line": 138,
        "text": "result = client.run({"
      },
      {
        "line": 139,
        "text": "    \"app\": \"infsh/remotion-render\","
      },
      {
        "line": 140,
        "text": "    \"input\": {"
      },
      {
        "line": 141,
        "text": "        \"code\": \"\"\""
      },
      {
        "line": 142,
        "text": "import { useCurrentFrame, AbsoluteFill, interpolate } from \"remotion\";"
      },
      {
        "line": 143,
        "text": ""
      },
      {
        "line": 144,
        "text": "export default function Main() {"
      },
      {
        "line": 145,
        "text": "  const frame = useCurrentFrame();"
      },
      {
        "line": 146,
        "text": "  const opacity = interpolate(frame, [0, 30], [0, 1]);"
      },
      {
        "line": 147,
        "text": ""
      },
      {
        "line": 148,
        "text": "  return ("
      },
      {
        "line": 149,
        "text": "    <AbsoluteFill style={{"
      },
      {
        "line": 150,
        "text": "      backgroundColor: \"#1a1a2e\","
      },
      {
        "line": 151,
        "text": "      display: \"flex\","
      },
      {
        "line": 152,
        "text": "      justifyContent: \"center\","
      },
      {
        "line": 153,
        "text": "      alignItems: \"center\""
      },
      {
        "line": 154,
        "text": "    }}>"
      },
      {
        "line": 155,
        "text": "      <h1 style={{ color: \"#eee\", fontSize: 80, opacity }}>"
      },
      {
        "line": 156,
        "text": "        Hello from Python"
      },
      {
        "line": 157,
        "text": "      </h1>"
      },
      {
        "line": 158,
        "text": "    </AbsoluteFill>"
      },
      {
        "line": 159,
        "text": "  );"
      },
      {
        "line": 160,
        "text": "}"
      },
      {
        "line": 161,
        "text": "\"\"\","
      },
      {
        "line": 162,
        "text": "        \"duration_seconds\": 3,"
      },
      {
        "line": 163,
        "text": "        \"fps\": 30,"
      },
      {
        "line": 164,
        "text": "        \"width\": 1920,"
      },
      {
        "line": 165,
        "text": "        \"height\": 1080"
      },
      {
        "line": 166,
        "text": "    }"
      },
      {
        "line": 167,
        "text": "})"
      },
      {
        "line": 168,
        "text": ""
      },
      {
        "line": 169,
        "text": "print(result[\"output\"][\"video\"])"
      },
      {
        "line": 170,
        "text": "```"
      },
      {
        "line": 171,
        "text": ""
      },
      {
        "line": 172,
        "text": "### Streaming Progress"
      },
      {
        "line": 173,
        "text": ""
      },
      {
        "line": 174,
        "text": "```python"
      },
      {
        "line": 175,
        "text": "for update in client.run({"
      },
      {
        "line": 176,
        "text": "    \"app\": \"infsh/remotion-render\","
      },
      {
        "line": 177,
        "text": "    \"input\": {"
      },
      {
        "line": 178,
        "text": "        \"code\": \"...\","
      },
      {
        "line": 179,
        "text": "        \"duration_seconds\": 10"
      },
      {
        "line": 180,
        "text": "    }"
      },
      {
        "line": 181,
        "text": "}, stream=True):"
      },
      {
        "line": 182,
        "text": "    if update.get(\"progress\"):"
      },
      {
        "line": 183,
        "text": "        print(f\"Rendering: {update['progress']}%\")"
      },
      {
        "line": 184,
        "text": "    if update.get(\"output\"):"
      },
      {
        "line": 185,
        "text": "        print(f\"Video: {update['output']['video']}\")"
      },
      {
        "line": 186,
        "text": "```"
