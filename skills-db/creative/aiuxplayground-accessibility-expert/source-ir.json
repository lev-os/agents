      },
      {
        "line": 18,
        "text": ""
      },
      {
        "line": 19,
        "text": "### Level AA (Target for most)"
      },
      {
        "line": 20,
        "text": "- 4.5:1 contrast for text"
      },
      {
        "line": 21,
        "text": "- 3:1 contrast for UI components"
      },
      {
        "line": 22,
        "text": "- Text resizable to 200%"
      },
      {
        "line": 23,
        "text": "- Focus visible on all elements"
      },
      {
        "line": 24,
        "text": "- Error suggestions provided"
      },
      {
        "line": 25,
        "text": ""
      },
      {
        "line": 26,
        "text": "### Level AAA (Enhanced)"
      },
      {
        "line": 27,
        "text": "- 7:1 contrast ratio"
      },
      {
        "line": 28,
        "text": "- Sign language for video"
      },
      {
        "line": 29,
        "text": "- Extended audio descriptions"
      },
      {
        "line": 30,
        "text": "- No timing-based interactions"
      },
      {
        "line": 31,
        "text": ""
      },
      {
        "line": 32,
        "text": "## Semantic HTML First"
      },
      {
        "line": 33,
        "text": ""
      },
      {
        "line": 34,
        "text": "```html"
      },
      {
        "line": 35,
        "text": "<!-- Use semantic elements -->"
      },
      {
        "line": 36,
        "text": "<nav> instead of <div class=\"nav\">"
      },
      {
        "line": 37,
        "text": "<button> instead of <div onclick>"
      },
      {
        "line": 38,
        "text": "<main> instead of <div id=\"main\">"
      },
