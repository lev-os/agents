        "line": 98,
        "text": "## Color & Contrast"
      },
      {
        "line": 99,
        "text": ""
      },
      {
        "line": 100,
        "text": "### Don't Rely on Color Alone"
      },
      {
        "line": 101,
        "text": "- Add icons or patterns"
      },
      {
        "line": 102,
        "text": "- Use text labels"
      },
      {
        "line": 103,
        "text": "- Provide multiple indicators"
      },
      {
        "line": 104,
        "text": ""
      },
      {
        "line": 105,
        "text": "### Contrast Requirements"
      },
      {
        "line": 106,
        "text": "- Normal text: 4.5:1 minimum"
      },
      {
        "line": 107,
        "text": "- Large text (18px+): 3:1 minimum"
      },
      {
        "line": 108,
        "text": "- UI components: 3:1 minimum"
      },
      {
        "line": 109,
        "text": "- Focus indicators: 3:1 minimum"
