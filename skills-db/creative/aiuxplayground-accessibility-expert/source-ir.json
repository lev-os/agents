        "line": 39,
        "text": "<article> instead of <div class=\"article\">"
      },
      {
        "line": 40,
        "text": ""
      },
      {
        "line": 41,
        "text": "<!-- Proper heading hierarchy -->"
      },
      {
        "line": 42,
        "text": "<h1>Page Title</h1>"
      },
      {
        "line": 43,
        "text": "  <h2>Section</h2>"
      },
      {
