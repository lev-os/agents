        "line": 89,
        "text": ""
      },
      {
        "line": 90,
        "text": "### Testing Checklist"
      },
      {
        "line": 91,
        "text": "- [ ] Can navigate with keyboard only"
      },
      {
        "line": 92,
        "text": "- [ ] Screen reader announces all content"
