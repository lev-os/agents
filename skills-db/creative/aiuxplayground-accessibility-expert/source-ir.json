      },
      {
        "line": 51,
        "text": "<div role=\"tablist\">"
      },
      {
        "line": 52,
        "text": "  <button role=\"tab\" aria-selected=\"true\">Tab 1</button>"
      },
      {
        "line": 53,
        "text": "  <button role=\"tab\" aria-selected=\"false\">Tab 2</button>"
      },
      {
        "line": 54,
        "text": "</div>"
      },
      {
        "line": 55,
        "text": ""
      },
      {
