      {
        "line": 38,
        "text": "    ) {"
      },
      {
        "line": 39,
        "text": "        Row("
      },
      {
        "line": 40,
        "text": "            modifier = Modifier"
      },
      {
        "line": 41,
        "text": "                .padding(16.dp)"
      },
      {
