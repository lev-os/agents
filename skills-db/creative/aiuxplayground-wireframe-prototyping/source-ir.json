      },
      {
        "line": 19,
        "text": "## Overview"
      },
      {
        "line": 20,
        "text": ""
      },
      {
        "line": 21,
        "text": "Wireframes and prototypes bridge the gap between ideas and implementation, enabling teams to test concepts, get feedback, and refine designs before costly development."
      },
      {
        "line": 22,
        "text": ""
      },
      {
        "line": 23,
        "text": "## When to Use"
      },
      {
        "line": 24,
        "text": ""
      },
      {
        "line": 25,
        "text": "- Early concept validation"
      },
      {
        "line": 26,
        "text": "- Stakeholder alignment"
      },
      {
        "line": 27,
        "text": "- User testing and feedback"
      },
      {
        "line": 28,
        "text": "- Developer handoff"
      },
      {
        "line": 29,
        "text": "- Feature exploration"
      },
      {
        "line": 30,
        "text": "- UX problem-solving"
      },
      {
        "line": 31,
        "text": "- Rapid iteration"
      },
      {
        "line": 32,
        "text": ""
      },
      {
        "line": 33,
        "text": "## Quick Start"
      },
      {
        "line": 34,
        "text": ""
      },
      {
        "line": 35,
        "text": "Minimal working example:"
      },
      {
        "line": 36,
        "text": ""
      },
      {
        "line": 37,
        "text": "```yaml"
      },
      {
        "line": 38,
        "text": "Wireframe Principles:"
      },
      {
        "line": 39,
        "text": ""
      },
      {
        "line": 40,
        "text": "Low Fidelity (Sketches):"
      },
      {
        "line": 41,
        "text": "  Tools: Paper, whiteboard, Balsamiq"
      },
      {
        "line": 42,
        "text": "  Time: 30 minutes - 2 hours"
      },
      {
        "line": 43,
        "text": "  Detail: Basic layout, no colors/fonts"
      },
      {
        "line": 44,
        "text": "  Best For: Brainstorming, exploration"
      },
      {
        "line": 45,
        "text": "  Cost: Free"
      },
      {
        "line": 46,
        "text": ""
      },
      {
        "line": 47,
        "text": "Medium Fidelity:"
      },
      {
        "line": 48,
        "text": "  Tools: Figma, Sketch, Adobe XD"
      },
      {
        "line": 49,
        "text": "  Time: 2-8 hours"
      },
      {
        "line": 50,
        "text": "  Detail: Layout, content, basic interaction"
      },
      {
        "line": 51,
        "text": "  Best For: Team alignment, feedback"
      },
      {
        "line": 52,
        "text": "  Cost: Low"
      },
      {
        "line": 53,
        "text": ""
      },
      {
        "line": 54,
        "text": "High Fidelity:"
      },
      {
        "line": 55,
        "text": "  Tools: Figma, Framer, web dev tools"
      },
      {
        "line": 56,
        "text": "  Time: 8+ hours"
      },
      {
        "line": 57,
        "text": "  Detail: Visual design, interactions, animations"
      },
      {
        "line": 58,
        "text": "  Best For: Developer handoff, user testing"
      },
      {
        "line": 59,
        "text": "  Cost: Medium"
      },
      {
        "line": 60,
        "text": ""
      },
