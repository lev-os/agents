      {
        "line": 76,
        "text": "## Best Practices"
      },
      {
        "line": 77,
        "text": ""
      },
      {
        "line": 78,
        "text": "### \u2705 DO"
      },
      {
        "line": 79,
        "text": ""
      },
      {
        "line": 80,
        "text": "- Start with low-fidelity sketches"
      },
      {
        "line": 81,
        "text": "- Get feedback early and often"
      },
      {
        "line": 82,
        "text": "- Test with real users"
      },
      {
        "line": 83,
        "text": "- Iterate based on feedback"
      },
      {
        "line": 84,
        "text": "- Use consistent grids and spacing"
      },
      {
        "line": 85,
        "text": "- Document interaction flows"
      },
      {
        "line": 86,
        "text": "- Include edge cases (empty states, errors)"
      },
      {
        "line": 87,
        "text": "- Create mobile-first wireframes"
      },
      {
        "line": 88,
        "text": "- Share prototypes for collaboration"
      },
      {
        "line": 89,
        "text": "- Keep wireframes simple and focused"
      },
      {
        "line": 90,
        "text": ""
      },
      {
        "line": 91,
        "text": "### \u274c DON'T"
      },
      {
        "line": 92,
        "text": ""
      },
      {
        "line": 93,
        "text": "- Jump directly to high-fidelity"
      },
      {
        "line": 94,
        "text": "- Over-design before validation"
      },
      {
        "line": 95,
        "text": "- Ignore mobile/responsive needs"
      },
      {
        "line": 96,
        "text": "- Create wireframes without user input"
      },
      {
        "line": 97,
        "text": "- Leave interactions undefined"
      },
      {
        "line": 98,
        "text": "- Make wireframes too detailed"
      },
      {
        "line": 99,
        "text": "- Test only with team members"
      },
      {
        "line": 100,
        "text": "- Ignore accessibility"
      },
      {
        "line": 101,
        "text": "- Lock into designs too early"
      },
      {
        "line": 102,
        "text": "- Create unrealistic user flows"
      },
      {
        "line": 103,
        "text": ""
      },
      {
        "line": 104,
        "text": ""
      },
      {
