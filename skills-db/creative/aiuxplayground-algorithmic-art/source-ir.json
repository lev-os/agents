      "content_binding": null,
      "description": "Create generative art using p5.js with seeded randomness and interactive parameter exploration. Perfect for visual designers creating flow fields, particle systems, and computational aesthetics.",
      "github_url": "https://github.com/anthropics/skills/tree/main/skills/algorithmic-art",
      "slug": "algorithmic-art",
      "source": "anthropic",
      "source_label": "Anthropic",
